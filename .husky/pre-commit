#!/bin/sh
# Pre-commit hook: Run linting and security checks on staged files

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "${YELLOW}🔒 Running pre-commit security checks...${NC}"

# Check 1: Prevent .env file commits
echo "${YELLOW}1. Checking for .env files...${NC}"
if git diff --cached --name-only | grep -E '\.env(\.local|\.keys)?$' > /dev/null; then
  echo "${RED}❌ ERROR: .env files cannot be committed to git!${NC}"
  echo "   Use dotenvx to manage secrets securely."
  echo "   Unstage these files and try again:"
  git diff --cached --name-only | grep -E '\.env(\.local|\.keys)?$' | sed 's/^/   - /'
  exit 1
fi
echo "${GREEN}✓ No .env files found${NC}"

# Check 2: Prevent secrets/keys from being committed
echo "${YELLOW}2. Checking for potential hardcoded secrets...${NC}"
# Only check for actual hardcoded values with real-looking secrets (8+ alphanumeric chars)
# Ignore: schema definitions, comments, examples, test data, documentation
if git diff --cached -U0 | grep -E "^\+" | grep -vE "^\+\+\+" | grep -vE "^\+\s*[/\-#]" | grep -vE "(z\.|schema|Schema|example|test|mock|faker|describe|it\()" | grep -iE "(secret|api_key|private_key|token|password)\s*[:=]\s*['\"][A-Za-z0-9\-_]{8,}['\"]" > /dev/null 2>&1; then
  echo "${RED}❌ WARNING: Potential hardcoded secrets detected!${NC}"
  echo "   Please review the following lines:"
  git diff --cached -U0 | grep -E "^\+" | grep -vE "^\+\+\+" | grep -vE "^\+\s*[/\-#]" | grep -vE "(z\.|schema|Schema|example|test|mock|faker|describe|it\()" | grep -iE "(secret|api_key|private_key|token|password)\s*[:=]\s*['\"][A-Za-z0-9\-_]{8,}['\"]" | sed 's/^/   /'
  exit 1
fi
echo "${GREEN}✓ No obvious hardcoded secrets found${NC}"

# Check 3: Run lint-staged (eslint + auto-fix)
echo "${YELLOW}3. Running ESLint on staged files...${NC}"
npx lint-staged
if [ $? -ne 0 ]; then
  echo "${RED}❌ ESLint checks failed${NC}"
  exit 1
fi
echo "${GREEN}✓ ESLint checks passed${NC}"

# Check 4: Ensure package-lock.json is in sync
#
# Only a change to a dependency block can invalidate the lock. Demanding a
# staged lock for ANY package.json edit blocked commits that touch a script,
# the lint-staged config or a field like "engines" — npm install produces no
# lock diff for those, so there was nothing to stage and no way to satisfy the
# check short of skipping the hook. The blocks are compared between the staged
# version and HEAD rather than grepped out of the diff, because a diff hunk
# does not say which block it fell inside.
echo "${YELLOW}4. Checking package-lock.json sync...${NC}"

# Takes a full git object spec: ":package.json" is the staged copy,
# "HEAD:package.json" the committed one.
dependency_blocks() {
  git show "$1" 2>/dev/null | awk '
    /^  "(dependencies|devDependencies|optionalDependencies|peerDependencies|overrides)"[[:space:]]*:/ { inblock = 1 }
    inblock { print }
    inblock && /^  \}/ { inblock = 0 }
  '
}

if git diff --cached --name-only | grep -E '(^|/)package\.json$' > /dev/null; then
  if [ "$(dependency_blocks :package.json)" != "$(dependency_blocks HEAD:package.json)" ]; then
    if ! git diff --cached --name-only | grep -E '(^|/)package-lock\.json$' > /dev/null; then
      echo "${RED}❌ ERROR: package.json dependencies changed but package-lock.json was not updated${NC}"
      echo "   Run: npm install"
      echo "   Then stage the package-lock.json changes"
      exit 1
    fi
  fi
fi
echo "${GREEN}✓ package-lock.json in sync${NC}"

echo ""
echo "${GREEN}✅ All pre-commit checks passed!${NC}"
exit 0
