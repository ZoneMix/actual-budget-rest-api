# =============================================================================
# Environment Configuration
# =============================================================================
# Copy this file to .env.local for development.
# For production, use a secrets manager (Docker secrets, GitHub Secrets, ...).
#
# Every variable src/config/env.js validates is listed below, in the same order
# and under the same headings, with its default. A commented-out line means the
# variable has no default and is either optional or required only in
# production; an uncommented line shows the value the app falls back to.
#
# Anything not listed here is not read by the app.


# =============================================================================
# Server Configuration
# =============================================================================

# development | production | test. Production tightens secret validation,
# cookie flags and error detail.
NODE_ENV=development

# TCP port the API listens on.
PORT=3000

# Trust X-Forwarded-* headers. Set true behind a reverse proxy so rate limiting
# and cookies see the real client. Implied by NODE_ENV=production.
TRUST_PROXY=false


# =============================================================================
# Authentication & Security
# =============================================================================

# Username of the bootstrap admin account, created on first start.
ADMIN_USER=admin

# REQUIRED, no default. Password for ADMIN_USER.
ADMIN_PASSWORD=your_secure_password

# REQUIRED IN PRODUCTION (32+ chars, all three different from each other).
# In development each is auto-generated at startup, so sessions and tokens do
# not survive a restart.
# JWT_SECRET=your_jwt_secret_at_least_32_characters
# JWT_REFRESH_SECRET=your_refresh_secret_different_from_jwt_secret
# SESSION_SECRET=your_session_secret_different_from_jwt_secrets

# Lifetime of an access token, as an ms-style duration.
JWT_ACCESS_TTL=1h

# Lifetime of a refresh token.
JWT_REFRESH_TTL=24h

# Scope enforcement rollout: off | warn | enforce.
# warn (the default) only logs `auth:SCOPE_WOULD_DENY` on a would-be denial, so
# no existing caller starts getting 403s. Switch to enforce once that log is
# quiet. Admin-only endpoints enforce in every mode.
AUTH_SCOPE_ENFORCEMENT=warn

# JWT `iss` and `aud` claims, pinned on both sign and verify. Changing either
# invalidates every token already issued with the previous value.
JWT_ISSUER=actual-wrapper
JWT_AUDIENCE=n8n


# =============================================================================
# Actual Budget Integration
# =============================================================================

# REQUIRED, no default. URL of the actual-server instance to sync with.
ACTUAL_SERVER_URL=http://localhost:5006

# REQUIRED, no default. Password for that server.
ACTUAL_PASSWORD=your_actual_password

# REQUIRED, no default. Sync id of the budget file to open (Actual calls this
# the Sync ID, under Settings → Advanced).
ACTUAL_SYNC_ID=your_sync_id

# End-to-end encryption password for the budget file. Set it only when the file
# is E2E encrypted; leave unset otherwise.
# ACTUAL_FILE_PASSWORD=your_budget_file_password

# Where the engine keeps its local cache of the budget. Must be writable and
# should be a persistent volume — losing it forces a full re-sync.
DATA_DIR=/app/.actual-cache


# =============================================================================
# Actual Engine Queue & Sync Policy
# =============================================================================

# Every call into the embedded engine is serialised. Pending operations above
# this depth are rejected with HTTP 503 rather than queued indefinitely.
ACTUAL_QUEUE_MAX_DEPTH=100

# Per-operation caller timeout in ms. On expiry the caller gets HTTP 504; the
# engine call is NOT cancelled and keeps its queue slot until it settles.
ACTUAL_OP_TIMEOUT_MS=60000

# Minimum age in ms of the last successful sync before a read triggers another.
# A read may therefore return data up to this stale. Writes always sync
# afterwards. 0 restores sync-before-every-read.
ACTUAL_SYNC_MIN_INTERVAL_MS=5000


# =============================================================================
# CORS Configuration
# =============================================================================

# Comma-separated origins allowed to call the API from a browser. Requests with
# no Origin header (curl, n8n, mobile) are always allowed.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5678


# =============================================================================
# Logging Configuration
# =============================================================================

# error | warn | info | debug.
LOG_LEVEL=info


# =============================================================================
# Redis Configuration (optional — for distributed rate limiting)
# =============================================================================
# With none of these set, rate limiting is per-process and in-memory, which is
# wrong as soon as more than one instance runs.

REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password

# Alternative to HOST/PORT/PASSWORD: one connection URL.
# REDIS_URL=redis://localhost:6379


# =============================================================================
# Database Configuration (the auth DB — users, tokens, OAuth clients)
# =============================================================================
# This is NOT the budget; the budget lives in DATA_DIR and on the Actual server.

# postgres (default) | sqlite. SQLite stores the DB at $DATA_DIR/auth.db and
# needs none of the POSTGRES_* variables.
DB_TYPE=postgres

# Required when DB_TYPE=postgres: either POSTGRES_URL, or all four of
# POSTGRES_HOST / POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# POSTGRES_URL=postgresql://user:password@host:port/database


# =============================================================================
# Security Features
# =============================================================================

# Toggle the CORS, Helmet and rate-limiting middleware. Leave them on.
ENABLE_CORS=true
ENABLE_HELMET=true
ENABLE_RATE_LIMITING=true

# Maximum JSON body size for ordinary routes. Bulk routes (transaction add and
# import, POST /v2/budgets/batch) mount their own 1mb parser and POST /v2/query
# its own 10kb one, so neither is governed by this value.
MAX_REQUEST_SIZE=10kb


# =============================================================================
# ActualQL Query Limits
# =============================================================================

# Rows POST /v2/query returns before it truncates. A truncated response sets
# "truncated": true.
ACTUAL_QUERY_MAX_RESULTS=10000

# How deeply $and/$or filters may nest before the query is rejected with 400.
ACTUAL_QUERY_MAX_FILTER_DEPTH=5


# =============================================================================
# Minimum Requirements Summary
# =============================================================================
#
# Development minimum:
#   ADMIN_PASSWORD, ACTUAL_SERVER_URL, ACTUAL_PASSWORD, ACTUAL_SYNC_ID
#
# Production adds:
#   NODE_ENV=production
#   JWT_SECRET, JWT_REFRESH_SECRET, SESSION_SECRET — 32+ chars, all different
#   A real database: DB_TYPE=postgres with POSTGRES_URL or the four components
#
# Generate secrets: openssl rand -base64 32
