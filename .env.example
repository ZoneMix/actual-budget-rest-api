# =============================================================================
# Environment Configuration
# =============================================================================
# Copy this file to .env.local for development
# For production, use a secrets manager (GitHub Secrets, AWS Secrets Manager, etc.)


# =============================================================================
# Required - All Environments
# =============================================================================

NODE_ENV=development
ADMIN_PASSWORD=your_secure_password
ACTUAL_SERVER_URL=http://localhost:5006
ACTUAL_PASSWORD=your_actual_password
ACTUAL_SYNC_ID=your_sync_id


# =============================================================================
# Required - Production Only (optional in dev with auto-generated values)
# =============================================================================

# JWT_SECRET=your_jwt_secret_at_least_32_characters
# JWT_REFRESH_SECRET=your_refresh_secret_different_from_jwt_secret
# SESSION_SECRET=your_session_secret_different_from_jwt_secrets


# =============================================================================
# Server Configuration (Optional - defaults shown)
# =============================================================================

PORT=3000
TRUST_PROXY=false


# =============================================================================
# Authentication (Optional - defaults shown)
# =============================================================================

ADMIN_USER=admin
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=24h


# =============================================================================
# Actual Budget (Optional - defaults shown)
# =============================================================================

DATA_DIR=/app/.actual-cache

# End-to-end encryption password for the budget file.
# Only set this when the budget file is E2E encrypted; leave unset otherwise.
# ACTUAL_FILE_PASSWORD=your_budget_file_password

# Engine queue: every call into the embedded Actual engine is serialised.
# Pending operations above this depth are rejected with HTTP 503.
ACTUAL_QUEUE_MAX_DEPTH=100

# Per-operation caller timeout. On expiry the caller gets HTTP 504; the engine
# call itself is NOT cancelled and keeps its queue slot until it settles.
ACTUAL_OP_TIMEOUT_MS=60000

# Reads only sync with the Actual server when the last successful sync is at
# least this old. Writes always sync afterwards. 0 syncs before every read.
ACTUAL_SYNC_MIN_INTERVAL_MS=5000


# =============================================================================
# Database (Optional - PostgreSQL is default)
# =============================================================================

DB_TYPE=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# Alternative: Use connection URL instead of individual components
# POSTGRES_URL=postgresql://user:password@host:port/database

# For SQLite: uncomment below and comment out PostgreSQL settings
# DB_TYPE=sqlite


# =============================================================================
# Redis (Optional - for distributed rate limiting)
# =============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password

# Alternative: Use connection URL instead
# REDIS_URL=redis://localhost:6379


# =============================================================================
# CORS & Security (Optional - defaults shown)
# =============================================================================

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5678
ENABLE_CORS=true
ENABLE_HELMET=true
ENABLE_RATE_LIMITING=true
MAX_REQUEST_SIZE=10kb


# =============================================================================
# Logging (Optional - defaults shown)
# =============================================================================

LOG_LEVEL=info


# =============================================================================
# ActualQL Query Limits (Optional - defaults shown)
# =============================================================================
#
# ACTUAL_QUERY_MAX_RESULTS      Rows POST /v2/query returns before it truncates.
#                               A truncated response sets "truncated": true.
# ACTUAL_QUERY_MAX_FILTER_DEPTH How deeply $and/$or filters may nest before the
#                               query is rejected with 400.

ACTUAL_QUERY_MAX_RESULTS=10000
ACTUAL_QUERY_MAX_FILTER_DEPTH=5


# =============================================================================
# Minimum Requirements Summary
# =============================================================================
#
# Development Minimum:
#   - NODE_ENV=development
#   - ADMIN_PASSWORD
#   - ACTUAL_SERVER_URL
#   - ACTUAL_PASSWORD
#   - ACTUAL_SYNC_ID
#
# Production Minimum:
#   - All development requirements above
#   - JWT_SECRET (32+ characters, unique)
#   - JWT_REFRESH_SECRET (32+ characters, different from JWT_SECRET)
#   - SESSION_SECRET (32+ characters, different from JWT secrets)
#   - NODE_ENV=production
#
# Generate secrets: openssl rand -base64 32
